PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
CLIENT_URL=http://localhost:3000

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Admin auth (used to log into /admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# JWT_SECRET MUST be >= 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=replace-this-with-output-of-openssl-rand-hex-32-at-least-32-chars

